@echo off
setlocal EnableExtensions
set "EXTENSION_ID=__EXTENSION_ID__"
set "DATA_DIR=%LOCALAPPDATA%\H Local\native-host"
set "SERVER_"
set "HOST_"

where node >nul 2>nul
if errorlevel 1 (
  echo [ERROR] Node.js was not found on PATH. Install Node.js first: https://nodejs.org/
  pause
  exit /b 1
)

if not exist "%DATA_DIR%" mkdir "%DATA_DIR%"

powershell -NoProfile -ExecutionPolicy Bypass -Command ^
  "$ErrorActionPreference='Stop';" ^
  "$dir=$env:DATA_DIR;" ^
  "$node=(Get-Command node).Source;" ^
  "$utf8=New-Object System.Text.UTF8Encoding($false);" ^
  "[IO.File]::WriteAllText((Join-Path $dir 'server.mjs'),[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($env:SERVER_B64)),$utf8);" ^
  "[IO.File]::WriteAllText((Join-Path $dir 'native-host.mjs'),[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($env:HOST_B64)),$utf8);" ^
  "$cmd='@echo off' + [Environment]::NewLine + '\"'+$node+'\" \"%~dp0native-host.mjs\"' + [Environment]::NewLine;" ^
  "[IO.File]::WriteAllText((Join-Path $dir 'hlocal-host.cmd'),$cmd,$utf8);" ^
  "$manifestPath=Join-Path $dir 'com.hlocal.server.json';" ^
  "$manifest=@{name='com.hlocal.server';description='Hypothesis Enhanced local annotation server';path=(Join-Path $dir 'hlocal-host.cmd');type='stdio';allowed_origins=@('chrome-extension://'+$env:EXTENSION_ID+'/')} | ConvertTo-Json -Depth 3;" ^
  "[IO.File]::WriteAllText($manifestPath,$manifest,$utf8);" ^
  "foreach($root in @('HKCU:\Software\Google\Chrome\NativeMessagingHosts\com.hlocal.server','HKCU:\Software\Microsoft\Edge\NativeMessagingHosts\com.hlocal.server')){New-Item -Force -Path $root | Out-Null; Set-Item -Path $root -Value $manifestPath;}"

if errorlevel 1 (
  echo [ERROR] Native host installation failed.
  pause
  exit /b 1
)

echo [OK] H Local native host installed.
echo [OK] Please fully restart Chrome/Edge.
pause
