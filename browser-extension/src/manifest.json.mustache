{
  "name": "Hypothesis 增强版 - 本地网页与图片批注",
  "short_name": "Hypothesis+",
  "version": "{{ version }}",
  {{#browserIsChrome}}
  "version_name": "{{ version }} ({{ versionName }})",
  {{/browserIsChrome}}
  "manifest_version": 3,

  {{#browserIsChrome}}
  "minimum_chrome_version": "88",
  {{/browserIsChrome}}

  {{#key}}
  "key": "{{{ key }}}",
  {{/key}}

  {{#browserIsFirefox}}
  "applications": {
    "gecko": {
      "strict_min_version": "68.0"
    }
  },
  {{/browserIsFirefox}}

  "description": "在保留官方网页与 PDF 批注功能的基础上，增加免登录本地模式、网页图片框选/打点批注与局域网协作。基于 Hypothesis 官方仓库二次开发。",
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },

  {{#browserIsChrome}}
  "incognito": "split",
  {{/browserIsChrome}}

  "options_ui": {
    "page": "options/index.html"
  },

  {{#browserIsChrome}}
  {{#localApi}}
  "offline_enabled": true,
  {{/localApi}}
  {{^localApi}}
  "offline_enabled": false,
  {{/localApi}}
  {{/browserIsChrome}}

  "permissions": [
    "scripting",
    "storage",
    "tabs",
    {{! Download one-click native-host installer scripts. }}
    "downloads",
    {{! Launch the bundled native helper which runs the LAN server. }}
    "nativeMessaging"
  ],

  "host_permissions": ["<all_urls>"],

  "optional_permissions": [
    {{! Used to enumerate frames on certain websites. }}
    "webNavigation"
  ],

  "background": {
    "service_worker": "extension.bundle.js"
  },

  "action": {
    "default_icon": {
      "19": "images/browser-icon-inactive.png",
      "38": "images/browser-icon-inactive@2x.png"
    }
  },

  {{#browserIsChrome}}
  {{#bouncerUrl}}
  "externally_connectable": {
    "matches": ["{{&bouncerUrl}}*"]
  },
  {{/bouncerUrl}}
  {{/browserIsChrome}}

  "web_accessible_resources": [
    {
      "resources": [
        "client/*",
        "help/*",
        "native-host/*",
        "pdfjs/*",
        "pdfjs/web/viewer.html"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
